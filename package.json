{
  "name": "verifiable-premises",
  "version": "0.1.0",
  "private": true,
  "description": "Check every premise a task relies on against a quoted primary source, and link each test to the premise it pins",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "premises": "bin/premises.mjs"
  },
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "test": "node --test test/premises.test.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
